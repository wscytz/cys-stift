{
  "name": "cys-stift",
  "version": "1.6.0",
  "private": true,
  "description": "cy's Stift — 本地优先的灵感画布",
  "author": "cy",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "benchmark:intent": "pnpm --filter web test -- src/features/ai/__tests__/intent-benchmark.test.ts src/features/ai/__tests__/intent-compiler.test.ts",
    "benchmark:proposal": "pnpm --filter web test -- src/features/ai/coauthor/__tests__/proposal-benchmark.test.ts",
    "smoke:proposal": "node scripts/smoke-proposal-coauthor.mjs",
    "e2e:ai": "node scripts/e2e-ai.mjs",
    "e2e:data": "node scripts/e2e-data.mjs",
    "e2e:canvas": "node scripts/e2e-r18-canvas.mjs",
    "e2e:dsl-seed": "node scripts/e2e-dsl-seed.mjs",
    "e2e:visual": "node scripts/e2e-pass6-visual.mjs",
    "test:sanitize": "node scripts/sanitize-web-out.test.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "sweep": "node scripts/render-sweep.mjs",
    "demo:approval": "node scripts/approval-demo.mjs",
    "audit:motion": "node scripts/motion-audit.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "tauri": "pnpm --filter desktop tauri",
    "clean": "pnpm -r exec rm -rf .next out dist node_modules/.cache"
  },
  "pnpm": {
    "overrides": {
      "markitdownllm>xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
      "pdfjs-dist": "6.2.108",
      "mammoth>@xmldom/xmldom": "0.8.15",
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.5",
      "postcss>nanoid": "3.3.18",
      "postcss>source-map-js": "1.2.2",
      "css-tree>source-map-js": "1.2.2",
      "katex": "0.18.2",
      "vite": "6.4.5",
      "vite>postcss": "8.5.23",
      "jsdom>undici": "7.30.1",
      "chromium-bidi>zod": "4.6.6"
    }
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "puppeteer-core": "25.18.0",
    "typescript": "5.6.3",
    "vite": "6.4.5"
  }
}
