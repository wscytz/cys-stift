{
  "name": "@wscytz/dsl",
  "version": "0.1.1",
  "description": "Bidirectional text<->canvas description language: relational layout solved by an engine (group anchors, collision avoidance), structured card fields, zero runtime dependencies.",
  "license": "Apache-2.0",
  "keywords": [
    "canvas",
    "dsl",
    "layout",
    "llm",
    "svg",
    "json-canvas",
    "relational"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wscytz/cys-stift.git",
    "directory": "packages/cys-dsl"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/dsl-parser.gen.js src/dsl-parser.gen.d.ts dist/",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "gen": "peggy src/dsl.peggy -o src/dsl-parser.gen.js --format es",
    "cli": "tsx src/cli.ts",
    "debug:page": "tsc -p tsconfig.build.json && node debug/build-debug-page.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "cys-dsl": "./dist/cli.js"
    }
  },
  "devDependencies": {
    "@cys-stift/canvas-engine": "workspace:*",
    "@cys-stift/domain": "workspace:*",
    "@types/node": "22.9.0",
    "peggy": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
